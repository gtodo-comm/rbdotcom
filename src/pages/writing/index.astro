---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { categoryLabels } from '../../data/site';
const all = (await getCollection('writing')).sort((a,b)=>+b.data.date-+a.data.date);
const cats = [...new Set(all.map(p=>p.data.category))];
---
<Base title="Writing" description="Stories, advice and musings by Rashmi Bansal.">
  <section class="wrap" style="padding-top:2rem">
    <p class="eyebrow">Writing</p><h1>Stories worth reading.</h1>
    <p class="lede serif">A few sample pieces: stories from the books and advice for entrepreneurs.</p>
    <p class="chips">{cats.map(c => <a href={`#${c}`}>{categoryLabels[c] ?? c}</a>)}</p>
    {cats.map(c => (
      <section id={c}>
        <h2>{categoryLabels[c] ?? c}</h2>
        <ul>{all.filter(p=>p.data.category===c).map(p => <li><a href={`/writing/${p.id}`}>{p.data.title}</a></li>)}</ul>
      </section>
    ))}
  </section>
  <style>
    .chips{display:flex;gap:.6rem;flex-wrap:wrap;margin:1.5rem 0 3rem}.chips a{border:2px solid var(--black);padding:.25rem .8rem;text-decoration:none;font-size:.9rem;background:#fff}
    .chips a:hover{background:var(--yellow)}
    section section{margin-bottom:3rem}ul{columns:2 280px;column-gap:2rem;padding-left:1.1rem}li{margin-bottom:.4rem;break-inside:avoid}
  </style>
</Base>
