---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Workshops and talks" description="Writing workshops and talks by Rashmi Bansal.">
  <section class="wrap" style="padding-top:2rem">
    <p class="eyebrow">Workshops and talks</p><h1>Stories that change how people work and write.</h1>
    <div class="two">
      <div><h2>Workshops</h2>
        <p>Hands-on short story writing for adults and for kids aged 9 to 14. Adults come to write better and to enjoy writing again. Parents send their children to build a writing habit.</p>
        <ul><li>Short story writing</li><li>Writing for kids</li><li>My first startup</li></ul></div>
      <div><h2>Talks</h2>
        <p>For companies, colleges and conferences: commencement speeches, keynotes and panels. Real stories from entrepreneurs across India, tied back to what your team or students can act on.</p>
        <ul><li>Storytelling</li><li>Intrapreneurship and innovation</li><li>Entrepreneurship and purpose</li></ul></div>
    </div>
    <p><a class="btn" href="/contact">Enquire</a></p>
    <p class="note">Draft topics. Photos, past clients and testimonials get added when Varsha's gallery arrives.</p>
  </section>
  <style>.two{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:3rem;margin:2rem 0}.note{font-size:.85rem;opacity:.6}</style>
</Base>
