---
import SignupForm from './SignupForm.astro';
import Signature from './Signature.astro';
import { site } from '../data/site';
---
<section class="nl" id="newsletter">
  <div class="wrap in">
    <div class="note">
      <h2><mark class="ph">{site.newsletter.name}</mark></h2>
      <p><mark class="ph">{site.note}</mark></p>
      <div class="sign"><Signature mode="view" invert /></div>
    </div>
    <div class="form">
      <p class="proof">Read by <mark class="ph">{site.newsletter.readers}</mark> people every week.</p>
      <SignupForm />
    </div>
  </div>
  <style>
    .nl{position:relative;overflow:hidden;background:var(--black);color:#fff;padding:clamp(3.5rem,8vw,6rem) 0;margin-top:clamp(3.5rem,7vw,5.5rem)}
    .nl + :global(footer){margin-top:0}
    .in{position:relative;display:grid;grid-template-columns:1.1fr 1fr;gap:2.5rem 5rem;align-items:center}
    @media (max-width:760px){.in{grid-template-columns:1fr}}
    .nl h2{font-size:clamp(1.7rem,3.4vw,2.4rem);margin:0 0 1rem}
    .note p{margin:0 0 .8rem;font-size:1.15rem;line-height:1.55;max-width:34ch}
    .sign{--sig-h:84px;margin-top:1.75rem}
    .proof{margin:0 0 .9rem}
    .nl :global(.btn){background:#fff;color:var(--black)}
    .nl :global(.btn:hover){opacity:.8}
    .nl :global(input){border-color:#fff}
  </style>
</section>
