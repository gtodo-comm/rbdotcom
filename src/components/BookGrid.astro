---
import { books } from '../data/site';
const { limit } = Astro.props;
const list = limit ? books.slice(0, limit) : books;
---
<ul class="grid">
  {list.map(b => (
    <li>
      <a href={b.buy} rel="noopener" target="_blank">
        <span class="cover"><img src={`/books/${b.cover}.jpg`} alt={`${b.title} book cover`} loading="lazy" /></span>
        <strong>{b.title}</strong>
        <span>{b.sub}</span>
      </a>
    </li>
  ))}
</ul>
<style>
  .grid{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:2.5rem 1.75rem}
  @media (max-width:600px){.grid{grid-template-columns:repeat(2,1fr);gap:1.75rem 1rem}}
  a{text-decoration:none;display:block}
  /* Hardcover effect, adapted from kepano's Obsidian book-covers snippet */
  .cover{position:relative;display:block;margin-bottom:1rem;border-radius:2px 6px 6px 2px;overflow:hidden;
    box-shadow:inset 1px 1px 0 1px rgba(255,255,255,.2),inset 0 0 0 1px rgba(0,0,0,.1),-4px 2px 4px 0 rgba(0,0,0,.3),-8px 8px 20px 0 rgba(0,0,0,.2);
    transition:transform .15s ease-out,box-shadow .15s ease-out}
  .cover::before{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;
    background-image:linear-gradient(to right,rgba(0,0,0,.2),rgba(255,255,255,.3) 1%,transparent 6%,rgba(0,0,0,.15) 8%,rgba(255,255,255,.2) 9%,transparent 20%)}
  a:hover .cover,a:focus-visible .cover{transform:translateY(-4px) scale(1.03);
    box-shadow:inset 1px 1px 0 1px rgba(255,255,255,.2),inset 0 0 0 1px rgba(0,0,0,.1),-4px 4px 8px 0 rgba(0,0,0,.3),-12px 16px 30px 0 rgba(0,0,0,.3)}
  @media (prefers-reduced-motion:reduce){.cover{transition:none}a:hover .cover{transform:none}}
  img{display:block;width:100%;aspect-ratio:2/3;object-fit:cover;background:var(--paper)}
  strong{display:block;line-height:1.25;font-size:.98rem}
  a > span:not(.cover){display:block;font-size:.85rem;line-height:1.4;margin-top:.15rem;opacity:.7}
  a:hover > span:not(.cover){opacity:1}
</style>
