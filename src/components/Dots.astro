---
// "Connect the dots" motif, after her best-known title: a sparse grid of dots with a few joined by a thin line.
// Deterministic (seeded), so the pattern is the same on every build.
const { w = 600, h = 300, step = 22, seed = 1, hole = null, focus = null, density = 0.6, link = 6, class: cls = '' } = Astro.props;
const fx = focus ? focus[0] : w / 2, fy = focus ? focus[1] : h / 2;
let a = seed;
const rnd = () => { a |= 0; a = (a + 0x6d2b79f5) | 0; let t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
const pts: number[][] = [];
for (let y = step / 2; y < h; y += step) for (let x = step / 2; x < w; x += step) {
  if (hole && x > hole[0] && x < hole[2] && y > hole[1] && y < hole[3]) { rnd(); continue; }
  const d = Math.hypot((x - fx) / (w / 2), (y - fy) / (h / 2));
  if (rnd() < density * Math.max(0, 1 - d) ** 1.15) pts.push([x, y]);
}
const sorted = [...pts].sort((p, q) => p[0] - q[0]);
const chosen: number[][] = [];
for (let i = 0; i < link && sorted.length; i++) {
  const p = sorted[Math.min(sorted.length - 1, Math.floor(((i + rnd() * 0.7) / link) * sorted.length))];
  if (!chosen.includes(p)) chosen.push(p);
}
---
<svg class:list={['dots', cls]} viewBox={`0 0 ${w} ${h}`} width={w} height={h} aria-hidden="true" focusable="false">
  <g fill="currentColor">{pts.filter((p) => !chosen.includes(p)).map(([x, y]) => <circle cx={x} cy={y} r="1.7" />)}</g>
  {chosen.length > 1 && <polyline points={chosen.map((p) => p.join(',')).join(' ')} fill="none" stroke="var(--dot-line, currentColor)" stroke-width="1" />}
  <g fill="var(--dot-line, currentColor)">{chosen.map(([x, y]) => <circle cx={x} cy={y} r="3" />)}</g>
</svg>
<style>
  .dots{display:block;pointer-events:none;max-width:none}
</style>
