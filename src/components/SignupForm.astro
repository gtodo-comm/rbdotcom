---
import { site } from '../data/site';
const live = !site.newsletterAction.startsWith('TODO_');
---
<form action={live ? site.newsletterAction : undefined} method="post" onsubmit={live ? undefined : 'event.preventDefault();this.querySelector("button").textContent="Signup opens soon";'}>
  <input type="email" name="email" placeholder="Your email address" required aria-label="Email address" />
  <button class="btn" type="submit">Subscribe</button>
</form>
<p class="fine">{site.newsletter.finePrint}</p>
<style>
  form{display:flex;gap:.5rem;flex-wrap:wrap}
  input{flex:1 1 220px;min-width:0;font:inherit;padding:.8rem 1rem;border:1px solid var(--black);border-radius:0;background:#fff;color:var(--black)}
  .fine{margin:.6rem 0 0;font-size:.82rem;opacity:.65}
</style>
